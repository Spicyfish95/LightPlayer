{
  "name": "lightplayer",
  "version": "1.0.0",
  "description": "LightPlayer - modern local video player with realtime captions",
  "main": "src/main.js",
  "author": "LightPlayer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win zip",
    "dist": "electron-builder --win zip"
  },
  "build": {
    "appId": "com.lightplayer.desktop",
    "productName": "LightPlayer",
    "npmRebuild": false,
    "compression": "normal",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "beforePack": "build/after-build.js",
    "afterPack": "build/after-build.js",
    "afterAllArtifactBuild": "build/after-build.js",
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "src/asr/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LightPlayer-${version}-win-${arch}-portable.zip"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
