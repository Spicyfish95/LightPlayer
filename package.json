{
  "name": "lightplayer",
  "version": "1.0.0",
  "description": "LightPlayer - modern local video player with realtime captions",
  "main": "src/main.js",
  "author": "LightPlayer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win zip",
    "dist": "electron-builder --win zip"
  },
  "build": {
    "appId": "com.lightplayer.desktop",
    "productName": "LightPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "src/asr_worker.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LightPlayer-${version}-win-${arch}-portable.zip",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
